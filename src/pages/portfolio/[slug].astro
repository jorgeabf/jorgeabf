---
import { getImage, Image } from 'astro:assets'
import { render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Prosa from '../../components/Prosa.astro'
import { getProyectos, listaStack, mesLargo, textoAcceso, tieneFicha, type Proyecto } from '../../lib/proyectos'

// Sólo los proyectos con cuerpo tienen ficha
export async function getStaticPaths() {
  const proyectos = await getProyectos()
  return proyectos.filter(tieneFicha).map((proyecto) => ({
    params: { slug: proyecto.id },
    props: { proyecto }
  }))
}

interface Props {
  proyecto: Proyecto
}

const { proyecto } = Astro.props
const { id, data } = proyecto
const { peso } = data
const { Content } = await render(proyecto)

// https://www.ejemplo.com/ → ejemplo.com; https://github.com/a/b → github.com/a/b
const legible = (url: string) => {
  const { host, pathname } = new URL(url)
  return host.replace(/^www\./, '') + pathname.replace(/\/$/, '')
}

// La ficha mide 52rem (.ficha), y la página llega a ese ancho en 60em: 52rem + 4rem de hueco
// a cada lado; por debajo, mide 100vw - 8rem, y en el móvil, 100vw - 3rem
const sizes = '(min-width: 60em) 52em, (min-width: 48em) calc(100vw - 8em), calc(100vw - 3em)'

// Al compartir la ficha, su captura: a los 1200×630 que piden las redes, recortada por abajo,
// y en JPEG, que lo leen todas
const imagenSocial = await getImage({
  src: data.imagen,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'top',
  format: 'jpg'
})
---

<Layout
  title={`${data.nombre} | Jorge Arce`}
  description={data.resumen}
  imagen={{
    src: imagenSocial.src,
    ancho: imagenSocial.attributes.width,
    alto: imagenSocial.attributes.height,
    alt: data.alt
  }}
>
  <article class='ficha'>
    <header class='ficha__cabecera'>
      <h1>{data.nombre}</h1>
      <p class='ficha__resumen medida-lectura'>{data.resumen}</p>
    </header>

    <Image
      class='ficha__captura'
      src={data.imagen}
      alt={data.alt}
      widths={[640, 960, 1280, 1600]}
      sizes={sizes}
      loading='eager'
      style={`view-transition-name: captura-${id}`}
    />

    <dl class='ficha__datos'>
      <div>
        <dt>Tipo</dt>
        <dd>{data.tipo === 'aplicacion' ? 'Aplicación' : 'Sitio'}</dd>
      </div>
      <div>
        <dt>Acceso</dt>
        <dd>{textoAcceso[data.acceso]}</dd>
      </div>
      <div>
        <dt>{data.fin ? 'Fechas' : 'Desde'}</dt>
        <dd>
          <time datetime={data.inicio}>{mesLargo(data.inicio)}</time>
          {
            data.fin && (
              <>
                {' '}
                a <time datetime={data.fin}>{mesLargo(data.fin)}</time>
              </>
            )
          }
        </dd>
      </div>
      <div>
        <dt>Hecho con</dt>
        <dd>{listaStack(data.stack)}</dd>
      </div>
      <div>
        <dt>Web</dt>
        <dd><a href={data.url}>{legible(data.url)}</a></dd>
      </div>
      {
        data.repo && (
          <div>
            <dt>Código</dt>
            <dd>
              <a href={data.repo}>{legible(data.repo)}</a>
              {data.licencia && <>, con licencia {data.licencia}</>}
            </dd>
          </div>
        )
      }
      {
        peso && (
          <div>
            <dt>Peso de la portada</dt>
            <dd>
              {peso.kb}&nbsp;KB en {peso.peticiones} peticiones,{' '}
              {peso.js ? <>{peso.js}&nbsp;KB de JavaScript</> : 'sin JavaScript'}{' '}
              (<time datetime={peso.medido}>{mesLargo(peso.medido)}</time>)
            </dd>
          </div>
        )
      }
    </dl>

    <Prosa>
      <Content />
    </Prosa>

    {/* A la fila de este proyecto, no al principio de la lista */}
    <p class='ficha__volver'><a href={`/#${id}`}>Volver a los proyectos</a></p>
  </article>
</Layout>

<style>
  @layer componentes {
    /* El ancho va con el sizes de la captura (en el frontmatter): si cambia uno, se rehace el otro */
    .ficha {
      max-inline-size: 52rem;
      padding-block: var(--espacio-4) var(--espacio-5);
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--espacio-5);
    }

    .ficha__cabecera {
      container-type: inline-size;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--espacio-2);
    }

    /* Con la letra grande, la marca del título baja de tamaño antes que partirse:
       7em es lo que mide «Autoescuela», la palabra más larga de los nombres.
       --letra-h1, el tamaño de siempre, sale de la base */
    h1 {
      font-size: min(var(--letra-h1), 100cqi / 7);
    }

    .ficha__resumen {
      color: var(--color-suave);
      font-size: var(--letra-media);
    }

    .ficha__captura {
      inline-size: 100%;
      border: 1px solid var(--color-borde);
      border-radius: var(--radio-2);
    }

    .ficha__datos {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--espacio-2);

      & > div {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
      }
    }

    dt {
      color: var(--color-suave);
      font-size: var(--letra-pequena);
    }

    /* Las direcciones no tienen por dónde partirse */
    dd {
      overflow-wrap: break-word;
    }

    @media (min-width: 48em) {
      .ficha__datos > div {
        grid-template-columns: 8rem minmax(0, 1fr);
        gap: var(--espacio-3);
        align-items: baseline;
      }
    }
  }
</style>
