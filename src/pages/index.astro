---
import Layout from '../layouts/Layout.astro'
import Contacto from '../components/Contacto.astro'
import Proyecto from '../components/Proyecto.astro'
import { GITHUB, LINKEDIN } from '../lib/contacto'
import { getProyectos } from '../lib/proyectos'

const proyectos = await getProyectos()

// Para los buscadores: el nombre de la web, que Google enseña en los resultados, y quién la hace
const web = new URL('/', Astro.site).href
const datosEstructurados = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${web}#web`,
      url: web,
      name: 'Jorge Arce',
      inLanguage: 'es',
      publisher: { '@id': `${web}#persona` }
    },
    {
      '@type': 'Person',
      '@id': `${web}#persona`,
      name: 'Jorge Arce',
      url: web,
      jobTitle: 'Desarrollador web',
      sameAs: [GITHUB, LINKEDIN]
    }
  ]
}
---

<Layout
  title='Jorge Arce, desarrollador web'
  description='Hago y mantengo webs de ajedrez y de formación sanitaria con Astro, TypeScript y CSS, y aplicaciones en Cloudflare.'
  cabecera={false}
>
  <script
    slot='head'
    type='application/ld+json'
    set:html={JSON.stringify(datosEstructurados)}
  />

  {/* El contacto, también aquí: el del final queda detrás de todos los proyectos */}
  <header class='presentacion'>
    <hgroup>
      <h1>Jorge Arce</h1>
      <p class='cargo'>Desarrollador web</p>
    </hgroup>
    <p class='medida-lectura'>
      Hago webs con Astro desde 2022 y me fijo sobre todo en
      la <strong>accesibilidad</strong>, el <strong>rendimiento</strong> y
      el <strong>SEO&nbsp;técnico</strong>.
    </p>
    <Contacto />
  </header>

  <section
    class='seccion'
    id='proyectos'
    aria-labelledby='titulo-proyectos'
  >
    <h2 id='titulo-proyectos'>Proyectos</h2>
    <ul
      class='proyectos'
      role='list'
    >
      {
        proyectos.map((proyecto, i) => (
          <Proyecto
            proyecto={proyecto}
            primero={i === 0}
          />
        ))
      }
    </ul>
  </section>

  <section
    class='seccion'
    aria-labelledby='titulo-contacto'
  >
    <h2 id='titulo-contacto'>Contacto</h2>
    <Contacto />
  </section>
</Layout>

<style>
  @layer componentes {
    /* El cargo, pegado al nombre; la entradilla y el contacto, más separados */
    .presentacion {
      padding-block: var(--espacio-6) var(--espacio-5);
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--espacio-4);
    }

    hgroup {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--espacio-1);
    }

    h1 {
      font-size: var(--letra-titulo);
      letter-spacing: -0.01em;
    }

    .cargo {
      color: var(--color-acento);
      font-size: var(--letra-media);
    }

    .seccion {
      padding-block: var(--espacio-5);
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--espacio-4);
    }

    h2 {
      font-size: var(--letra-grande);
    }

    /* Las palabras clave, resaltadas como en el inspector */
    strong {
      padding-inline: 0.15em;
      border-radius: var(--radio-1);
      background-color: color-mix(in oklch, var(--color-acento) 20%, transparent);
      font-weight: 600;
    }

    .proyectos {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    @media (min-width: 48em) {
      .presentacion {
        padding-block-start: calc(var(--espacio-6) * 1.5);
      }

      h1 {
        font-size: var(--letra-titulo-ancho);
      }
    }
  }
</style>
