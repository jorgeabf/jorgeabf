---
import Menu from './Menu.astro'
import Footer from './Footer.astro'
import MenuItem from './MenuItem.astro'
import AboutIcon from './icons/About.astro'
import PortfolioIcon from './icons/Portfolio.astro'
---

<div class='container'>
  <a
    href='#main-content'
    class='skip-to-content'
  >
    Ir al contenido
  </a>
  <Menu>
    <MenuItem
      name='Inicio'
      href='/'
    >
      <AboutIcon />
    </MenuItem>
    <MenuItem
      name='portfolio'
      href='/portfolio'
    >
      <PortfolioIcon />
    </MenuItem>
  </Menu>
  <slot />
  <Footer />
</div>

<style>
  .container {
    width: 100%;
    --max-width: 1100px;
    max-width: var(--max-width);
    min-height: 100vh;
    padding: 2em 1em 0;
    margin-inline: auto;
    display: grid;
    column-gap: 1em;
    row-gap: 1em;
    grid-template-columns: 1fr 1fr min-content;
    grid-template-rows: min-content 1fr max-content;
    grid-template-areas:
      'header header menu'
      'main main main'
      'footer footer footer';
  }

  .skip-to-content {
    position: absolute;
    top: -60px;
    left: 0;
    background-color: var(--secondary);
    color: var(--white);
    padding: 0.5em 1em;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .skip-to-content:focus {
    top: 0;
    z-index: 100;
  }
</style>
