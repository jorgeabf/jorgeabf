---
import { Font } from 'astro:assets'
import '../styles/tokens.css'
import '../styles/global.css'
import Cabecera from '../components/Cabecera.astro'
import Pie from '../components/Pie.astro'

// La que enseñan las redes al compartir la página
interface ImagenSocial {
  src: string
  ancho: number
  alto: number
  alt: string
}

interface Props {
  title: string
  description: string
  // La portada no la lleva: su h1 ya es el nombre
  cabecera?: boolean
  // El 404 se sirve en cualquier ruta: sin canonical
  canonica?: boolean
  // Las fichas llevan su captura; las demás páginas, la de la web
  imagen?: ImagenSocial
}

const imagenWeb: ImagenSocial = {
  src: '/og-image.png',
  ancho: 1200,
  alto: 630,
  alt: 'Jorge Arce, desarrollador web'
}

const { title, description, cabecera = true, canonica = true, imagen = imagenWeb } = Astro.props

const url = new URL(Astro.url.pathname, Astro.site)
const urlImagen = new URL(imagen.src, Astro.site)
---

<!doctype html>
<html lang='es'>
  <head>
    <meta charset='utf-8' />
    {/* El orden de las capas, antes que cualquier hoja: en el build, la hoja de una
        página puede ir delante de global.css (pasaba en el 404), y manda la capa
        que aparece primero */}
    <style is:inline>
      @layer reset, base, componentes, utilidades;
    </style>
    <meta
      name='viewport'
      content='width=device-width, initial-scale=1'
    />
    <title>{title}</title>
    <meta
      name='description'
      content={description}
    />
    {
      canonica && (
        <link
          rel='canonical'
          href={url}
        />
      )
    }
    <link
      rel='icon'
      type='image/svg+xml'
      href='/favicon.svg'
    />
    {/* La meta no lee variables CSS: el fondo de tokens.css, en hex */}
    <meta
      name='theme-color'
      media='(prefers-color-scheme: light)'
      content='#f8fafd'
    />
    <meta
      name='theme-color'
      media='(prefers-color-scheme: dark)'
      content='#0e141d'
    />
    <meta
      property='og:type'
      content='website'
    />
    <meta
      property='og:locale'
      content='es_ES'
    />
    <meta
      property='og:site_name'
      content='Jorge Arce'
    />
    <meta
      property='og:title'
      content={title}
    />
    <meta
      property='og:description'
      content={description}
    />
    {
      canonica && (
        <meta
          property='og:url'
          content={url}
        />
      )
    }
    <meta
      property='og:image'
      content={urlImagen}
    />
    <meta
      property='og:image:width'
      content={String(imagen.ancho)}
    />
    <meta
      property='og:image:height'
      content={String(imagen.alto)}
    />
    <meta
      property='og:image:alt'
      content={imagen.alt}
    />
    <meta
      name='twitter:card'
      content='summary_large_image'
    />
    <meta
      name='twitter:title'
      content={title}
    />
    <meta
      name='twitter:description'
      content={description}
    />
    <meta
      name='twitter:image'
      content={urlImagen}
    />
    <meta
      name='twitter:image:alt'
      content={imagen.alt}
    />
    <Font
      cssVariable='--fuente-titulos'
      preload
    />
    {/* Lo que una página añade al <head>: los datos estructurados de la portada */}
    <slot name='head' />
  </head>
  <body>
    <a
      class='salto'
      href='#contenido'
    >
      Ir al contenido
    </a>
    <div class='pagina'>
      {cabecera && <Cabecera />}
      <main id='contenido'>
        <slot />
      </main>
      <Pie />
    </div>
  </body>
</html>

<style>
  @layer componentes {
    /* Centrada, con un hueco mínimo a cada lado */
    .pagina {
      --hueco: var(--espacio-4);
      min-block-size: 100dvh;
      inline-size: min(100% - 2 * var(--hueco), var(--medida-pagina));
      margin-inline: auto;
      display: flex;
      flex-direction: column;
    }

    main {
      flex: 1 1 auto;
    }

    /* Escondido sobre el borde de arriba, sin transformar (si no, asoma 1px) */
    .salto {
      position: absolute;
      inset-inline-start: var(--espacio-3);
      bottom: 100%;
      padding: var(--espacio-1) var(--espacio-3);
      background-color: var(--color-texto);
      color: var(--color-fondo);

      &:focus-visible {
        translate: 0 calc(100% + var(--espacio-3));
      }
    }

    @media (min-width: 48em) {
      .pagina {
        --hueco: var(--espacio-6);
      }
    }
  }
</style>
